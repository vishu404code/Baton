# All optional. The desktop app sets what it needs itself.

# Where the SQLite database lives (the desktop app uses ~/Library/Application Support/Baton/data).
# BATON_DATA_DIR=./data

# Desktop / single-computer mode: sign in automatically as the local owner and serve the UI from the backend.
# BATON_LOCAL_MODE=1
# BATON_STATIC_DIR=../frontend/dist

# URL that tools connecting over MCP use to reach Baton (shown in the config snippets).
BATON_PUBLIC_URL=http://127.0.0.1:8765

# Defaults for new projects
BATON_DEFAULT_LEASE_MINUTES=15
BATON_DEFAULT_REQUIRE_APPROVAL=false

# API keys can also come from the environment instead of the AI Models screen.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

LOG_LEVEL=info
