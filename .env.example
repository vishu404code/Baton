# Copy to .env and adjust. Never commit .env.

# --- Database (used by docker-compose) ---
POSTGRES_USER=baton
POSTGRES_PASSWORD=baton
POSTGRES_DB=baton
# Set automatically inside Docker. Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://baton:baton@localhost:5432/baton

# --- Backend ---
# Host port the API, WebSocket and MCP server listen on.
BATON_PORT=8000
# URL agents use to reach the MCP server. Use your LAN IP (e.g. http://192.168.1.20:8000)
# so teammates' laptops on the same Wi-Fi can connect.
BATON_PUBLIC_URL=http://localhost:8000
# Comma-separated origins allowed by CORS (the frontend dev server).
BATON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults for newly created rooms.
BATON_DEFAULT_LEASE_MINUTES=15
BATON_DEFAULT_MIN_SOURCES=1
BATON_DEFAULT_REQUIRE_APPROVAL=true
# Seconds without a heartbeat or request before an agent shows as offline.
BATON_AGENT_ONLINE_SECONDS=120
# How often (seconds) the server sweeps for expired claim leases.
BATON_LEASE_SWEEP_SECONDS=10
# Pause (ms) between verification checks so the room can watch them tick live.
BATON_CHECK_DELAY_MS=300
LOG_LEVEL=info
